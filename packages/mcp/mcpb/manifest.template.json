{
  "manifest_version": "0.3",
  "name": "touryou-mcp",
  "display_name": "TouRyou (touryou-mcp)",
  "version": "@VERSION@",
  "description": "touryou の統合セッション用の MCP（touryou-mcp --stdio）。daemon は別に起動しておく（/setup）。",
  "author": { "name": "comcreate" },
  "repository": {
    "type": "git",
    "url": "https://github.com/comcreate/touryou"
  },
  "server": {
    "type": "node",
    "entry_point": "server/index.mjs",
    "mcp_config": {
      "command": "node",
      "args": ["${__dirname}/server/index.mjs", "--stdio"],
      "env": { "HOME": "${HOME}" }
    }
  },
  "compatibility": {
    "platforms": ["darwin"],
    "runtimes": { "node": ">=22.0.0" }
  },
  "license": "MIT"
}
